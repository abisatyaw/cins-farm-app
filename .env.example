# Copy to .env only if you need overrides. All defaults work locally.
# FARM_DATABASE_URL=sqlite:///.local/farm.sqlite3
# FARM_INITIAL_ADMIN_PASSWORD=<set a unique password, at least 10 characters>
FARM_COOKIE_SECURE=false
FARM_AVERAGE_EGG_KG=0.06
FARM_BOX_KG=15
FARM_TARGET_FCR=2.2
FARM_TARGET_HDP=85
# JSON array. Add your HTTPS origin for a deployed installation.
FARM_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
